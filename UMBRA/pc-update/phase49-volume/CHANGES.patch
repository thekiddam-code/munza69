+// Writes may wait for the verified PC library backup. Never replay a timed-out write.
+async function request(path,body){
+ const token=localStorage.getItem('remoteDeckToken');if(!token)throw Error('Pair this terminal first');
+ const durable=['backup','import','edit','delete','reorder','output'].includes(path),controller=new AbortController();
+ let timedOut=false;const timer=setTimeout(()=>{timedOut=true;controller.abort();},durable?180000:path==='link'?25000:10000);
